# ════════════════════════════════════════════════
# SHL Assessment Recommendation System
# Environment Variables
# ════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────
# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_actual_key



# ── Optional: Model selection ─────────────────────────────────
# Default: gemini-1.5-flash-latest (fast, cost-efficient)
# Options: gemini-1.5-flash-latest, gemini-1.5-pro-latest
GEMINI_MODEL=models/gemini-flash-latest

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# Keep low (0.1-0.3) for grounded recommendations
GEMINI_TEMPERATURE=0.2

# Max tokens in LLM response
GEMINI_MAX_TOKENS=2048

# ── Optional: File paths ──────────────────────────────────────
# Default paths (relative to project root)
SHL_CSV_PATH=shl_catalog.csv
SHL_INDEX_PATH=shl_index.faiss

# ── Optional: Embedding model ─────────────────────────────────
# Must match the model used to build the FAISS index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Optional: Server config ───────────────────────────────────
HOST=0.0.0.0
PORT=8000
